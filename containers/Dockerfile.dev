# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e

ARG NODE_VERSION
ARG PYTHON_VERSION
ARG UV_VERSION

ARG BUILD_HASH=dev-build
ARG BUILD_CHANNEL=main

ARG EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ARG AUXILIARY_EMBEDDING_MODEL=TaylorAI/bge-micro-v2

# ------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------

FROM --platform=$BUILDPLATFORM node:${NODE_VERSION}-alpine3.20 AS frontend

ARG BUILD_HASH
ARG BUILD_CHANNEL

USER root

WORKDIR /app

RUN apk add --no-cache git

ENV ONNXRUNTIME_NODE_INSTALL_CUDA=skip \
    CYPRESS_INSTALL_BINARY=0 \
    NODE_OPTIONS=--max-old-space-size=12288

# Install centrally managed frontend dependencies

COPY package.json package-lock.json .npmrc ./

# Install npm version defined in package.json
RUN npm install -g "npm@$(node -p "require('./package.json').engines.npm")"

RUN npm ci --force

# Copy application source

COPY openwebui/ ./

ENV APP_BUILD_HASH=${BUILD_HASH} \
    APP_BUILD_CHANNEL=${BUILD_CHANNEL}

RUN npm run build

# ------------------------------------------------------------------
# Dependency management
# ------------------------------------------------------------------

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

# ------------------------------------------------------------------
# Production runtime
# ------------------------------------------------------------------

FROM python:${PYTHON_VERSION}-slim-trixie AS runtime

ARG BUILD_HASH
ARG EMBEDDING_MODEL
ARG AUXILIARY_EMBEDDING_MODEL

USER root

ENV ENV=prod \
    PORT=8080 \
    DOCKER=true \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    HOME=/home/nonroot \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    USE_CUDA_DOCKER=false \
    USE_OLLAMA_DOCKER=false \
    USE_SLIM_DOCKER=false \
    SCARF_NO_ANALYTICS=true \
    DO_NOT_TRACK=true \
    ANONYMIZED_TELEMETRY=false

# Model configuration

ENV RAG_EMBEDDING_MODEL=${EMBEDDING_MODEL} \
    AUXILIARY_EMBEDDING_MODEL=${AUXILIARY_EMBEDDING_MODEL} \
    RAG_RERANKING_MODEL="" \
    WHISPER_MODEL=base \
    TIKTOKEN_ENCODING_NAME=cl100k_base

ENV DATA_DIR=/app/backend/data \
    HF_HOME=/app/backend/data/cache/embedding/models \
    SENTENCE_TRANSFORMERS_HOME=/app/backend/data/cache/embedding/models \
    WHISPER_MODEL_DIR=/app/backend/data/cache/whisper/models \
    TIKTOKEN_CACHE_DIR=/app/backend/data/cache/tiktoken \
    WEBUI_SECRET_KEY_FILE=/app/backend/data/.webui_secret_key

WORKDIR /app/backend

# Operating system dependencies

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        bash \
        curl \
        jq \
        ca-certificates \
        git \
        build-essential \
        libmariadb-dev \
        libsm6 \
        libxext6 \
        pandoc \
        ffmpeg && \
    rm -rf /var/lib/apt/lists/*

# Create non-root runtime user

RUN groupadd --gid 65532 nonroot && \
    useradd \
        --uid 65532 \
        --gid 65532 \
        --create-home \
        --shell /usr/sbin/nologin \
        nonroot

# Install centrally managed Python dependencies

COPY pyproject.toml uv.lock /app/

RUN --mount=from=uv,source=/uv,target=/tmp/uv \
    /tmp/uv sync --project /app --locked --no-dev --no-install-project \
        --extra cpu --python /usr/local/bin/python3 --no-cache

# Prepare runtime directories

RUN mkdir -p \
    /app/backend/data \
    /home/nonroot/.cache/chroma && \
    chown -R 65532:65532 \
        /app/backend/data \
        /home/nonroot

# Copy application

COPY --from=frontend /app/build /app/build
COPY --from=frontend /app/backend /app/backend
COPY --from=frontend /app/CHANGELOG.md /app/CHANGELOG.md
COPY --from=frontend /app/package.json /app/package.json

RUN chown -R 65532:65532 \
    /app/backend/data \
    /app/backend/open_webui/static

USER 65532:65532

# Download models during build

RUN python -c "import os; from sentence_transformers import SentenceTransformer; SentenceTransformer(os.environ['RAG_EMBEDDING_MODEL'], device='cpu')" && \
    python -c "import os; from sentence_transformers import SentenceTransformer; SentenceTransformer(os.environ['AUXILIARY_EMBEDDING_MODEL'], device='cpu')" && \
    python -c "import os; from faster_whisper import WhisperModel; WhisperModel(os.environ['WHISPER_MODEL'], device='cpu', compute_type='int8', download_root=os.environ['WHISPER_MODEL_DIR'])" && \
    python -c "import os; import tiktoken; tiktoken.get_encoding(os.environ['TIKTOKEN_ENCODING_NAME'])"

ENV WEBUI_BUILD_HASH=${BUILD_HASH}

EXPOSE 8080

HEALTHCHECK CMD curl --silent --fail \
    http://localhost:${PORT}/health \
    | jq -ne 'input.status == true' || exit 1

ENTRYPOINT []

CMD ["bash", "start.sh"]