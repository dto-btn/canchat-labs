{
  "name": "Package Management",
  "image": "mcr.microsoft.com/devcontainers/base:resolute",
  "overrideFeatureInstallOrder": [
    "ghcr.io/gccloudone-aurora-collab/devcontainer-features/enhanced-custom-root-ca"
  ],
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "none",
      "npmVersion": "none",
      "pnpmVersion": "none"
    },
    "ghcr.io/devcontainers-extra/features/uv:1": {
      "version": "0.12.10"
    },
    "ghcr.io/gccloudone-aurora-collab/devcontainer-features/enhanced-custom-root-ca:4": {
      "sources": "https://raw.githubusercontent.com/gccloudone-aurora-collab/goc-root-cert-mirror/main/certs/GoC-GdC-Root-A.crt",
      "fingerprints": "FE:E0:9E:77:43:BF:D4:3E:D7:D4:D3:ED:50:6C:C7:9D:2D:90:70:FF:A9:29:91:16:87:D4:27:33:70:BE:A3:06",
      "allowInsecureDownload": true
    }
  },
  "containerEnv": {
    "NODE_EXTRA_CA_CERTS": "/etc/ssl/certs/ca-certificates.crt",
    "UV_SYSTEM_CERTS": "true",
    "ONNXRUNTIME_NODE_INSTALL_CUDA": "skip",
    "CYPRESS_INSTALL_BINARY": "0"
  },
"postCreateCommand": "bash -c 'source \"$NVM_DIR/nvm.sh\" --no-use && nvm install && nvm alias default \"$(cat .nvmrc)\" && cd openwebui && uv venv --allow-existing'",
"customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "ms-python.python",
        "charliermarsh.ruff",
        "svelte.svelte-vscode"
      ]
    }
  }
}