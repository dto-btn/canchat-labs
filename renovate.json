"packageRules": [
    {
        "groupName": "GitHub Actions",
        "matchManagers": ["github-actions"],
        "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"]
    },
    {
        "groupName": "Svelte framework",
        "matchManagers": ["npm"],
        "matchPackageNames": [
            "svelte",
            "@sveltejs/*",
            "svelte-check",
            "vite",
            "vite-plugin-*"
        ],
        "matchUpdateTypes": ["minor", "patch"]
    },
    {
        "groupName": "Database and caching",
        "matchDatasources": ["pypi"],
        "matchPackageNames": [
            "sqlalchemy",
            "alembic",
            "psycopg*",
            "redis",
            "hiredis",
            "pymysql",
            "aiosqlite"
        ],
        "matchUpdateTypes": ["minor", "patch"]
    }
]